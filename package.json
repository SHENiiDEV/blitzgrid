{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "server": "node server/src/index.js",
        "serve:all": "concurrently -n \"laravel,socket,vite\" -c \"blue,magenta,cyan\" \"php artisan serve --port=8000\" \"node server/src/index.js\" \"vite\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.1",
        "@vitejs/plugin-react": "^6.1.1",
        "axios": "^1.20.0",
        "canvas-confetti": "^1.9.4",
        "clsx": "^2.1.1",
        "lucide-react": "^1.46.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^3.7.0"
    }
}
